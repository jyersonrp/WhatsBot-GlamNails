# -----------------------------------------------------------------------------
# WhatsBot — Glam Nails Maturín Environment Configuration
# -----------------------------------------------------------------------------

# Application Server
NODE_ENV=development
PORT=3000
# Secret used for signing JWT session cookies (min 32 characters)
APP_SECRET=glam_nails_super_secret_jwt_app_key_production_2026

# PostgreSQL Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsbot_glamnails

# WhatsApp Integration Driver
# Options: "mock" (default for testing in web simulator) | "meta" (Meta WhatsApp Cloud API)
WHATSAPP_MODE=mock

# Meta Cloud API v21.0 Credentials (Required if WHATSAPP_MODE=meta)
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=glamnails_webhook_verify_token_2026
WHATSAPP_APP_SECRET=a1b2c3d4e5f6...

# Google Gemini API (Optional — AI fallback for unhandled conversational questions)
GEMINI_API_KEY=
